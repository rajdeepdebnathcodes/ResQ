# ==========================================================
# ResQ Platform - Environment Variables Template
# Copy this file to server/.env and adjust your credentials
# ==========================================================

# Server Configuration
NODE_ENV=development
PORT=5000

# Client URL (for CORS in development)
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=resq_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# JWT Authentication Secret (Use a strong random string in production)
JWT_SECRET=resq_emergency_response_jwt_secret_key_2026_xyz
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key (Optional)
# If empty or invalid, the app automatically switches to Intelligent Fallback Mode!
GEMINI_API_KEY=

# File Upload Configuration
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads
